{
  "name": "@esg/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ESG 웹 화면: 그린워싱 화면 여섯(GW-00~05, 지금은 목 저장소), 문서 뷰어·검토 표 위젯, 서버 호출 클라이언트(shared/api), 개발용 데모 넷. 폴더 규칙은 src/app/guards/layers.test.ts",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node tools/prepare.ts && vite",
    "build": "node tools/prepare.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools e2e",
    "format:check": "prettier --check src tools e2e",
    "test": "vitest run",
    "test:browser": "playwright test",
    "convert": "node tools/convert.ts",
    "convert:table": "node tools/convert-table.ts",
    "measure:table": "node tools/measure-table.ts",
    "measure:places": "node tools/measure-places.ts",
    "measure:open": "node tools/measure-open.ts",
    "measure:hover": "node tools/measure-hover.ts",
    "measure:ink": "node tools/measure-ink.ts",
    "verify": "scripts/verify.sh",
    "capture": "node tools/capture.ts"
  },
  "dependencies": {
    "@marcspon/common": "workspace:*",
    "@marcspon/ui": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.103.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.5",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "pdfjs-dist": "6.4.299",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@marcspon/tailwind-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@toktokhan-dev/eslint-config": "0.0.2",
    "@toktokhan-dev/prettier-config": "0.0.1",
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "jsdom": "30.1.2",
    "postcss": "8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

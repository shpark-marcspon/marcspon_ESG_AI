{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 브라우저에서 도는 코드라 서버 쪽 기본값(NodeNext, node 타입만)을 바꾼다.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // tools/ 의 스크립트는 빌드 없이 node 가 .ts 를 바로 읽는다(Node 22 의 타입 지우기).
    // node 는 확장자를 채워 주지 않으므로, 이 패키지의 상대 경로 import 에는 전부 .ts / .tsx 를 적는다.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tools", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}

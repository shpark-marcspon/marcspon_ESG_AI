            {
              "type": "null"
            }
          ],
          "description": "parsed 의 self_check(객체일 때만, 아니면 null).",
          "title": "Selfcheck"
        },
        "topicNameMismatch": {
          "description": "답의 topic_name 이 입력 토픽명과 달랐는지(코랩 셀 22 의 견줌).",
          "title": "Topicnamemismatch",

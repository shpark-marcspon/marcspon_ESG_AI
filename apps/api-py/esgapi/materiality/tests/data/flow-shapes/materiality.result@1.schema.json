          "description": "코랩 묶음의 원문 칸 그대로(utm 지운 답. 코랩대로 호출 실패면 빈 글). 원문이 없으면 null.",
          "title": "Raw"
        },
        "parseError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "코랩 묶음의 parse_error 그대로 — 규제는 str(예외), 컨트로버시는 repr(예외) 이고 호출 실패면 no_result\n(코랩대로).",
          "title": "Parseerror"
        },
        "failure": {
          "$ref": "#/$defs/MaterialityFailure"
        }
      },
      "required": [
        "status",
        "raw",
        "parseError",
        "failure"
      ],

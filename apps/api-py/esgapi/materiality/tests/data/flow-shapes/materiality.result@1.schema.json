    "MaterialityFailure": {
      "additionalProperties": false,
      "description": "호출이나 답 읽기가 실패한 까닭.",
      "properties": {
        "kind": {
          "description": "unparsable = 모델의 답을 읽지 못함(빈 답·`{` 없음·JSON 아님·꼴이 다름). 그 밖은 모델 호출의 실패 갈래(core.llm 의\n이름 그대로).",
          "enum": [
            "unparsable",
            "budget_exceeded",
            "truncated",
            "refusal",
            "provider_error",
            "timeout",
            "tool_executor_raised",
            "schema_mismatch"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "description": "실패 갈래의 설명(모델 글·공급사 메시지·고객 데이터는 싣지 않는다).",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "MaterialityFailure",
      "type": "object"
    },
    "MaterialityKeywordsDone": {
      "additionalProperties": false,
      "description": "키워드 도출(코랩 셀 20)을 마쳤다.",

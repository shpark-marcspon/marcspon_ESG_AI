          "description": "모델이 낸 차례. 같은 토픽이 둘이면 코랩처럼 한 줄(첫 자리, 뒤 것의 키워드)만 남는다.",
          "items": {
            "$ref": "#/$defs/MaterialityTopicKeywords"
          },
          "title": "Bytopic",
          "type": "array"
        },
        "raw": {
          "description": "모델의 답 원문.",
          "title": "Raw",
          "type": "string"
        }
      },
      "required": [
        "status",
        "byTopic",
        "raw"
      ],
      "title": "MaterialityKeywordsDone",
      "type": "object"
    },
    "MaterialityKeywordsFailed": {
      "additionalProperties": false,
      "description": "키워드 도출이 실패했다. 컨트로버시 조사는 키워드 없이 계속한다(코랩대로).",
      "properties": {
        "status": {
          "const": "failed",

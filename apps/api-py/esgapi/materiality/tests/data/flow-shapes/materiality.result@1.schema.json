    "MaterialityOutcomeFailed": {
      "additionalProperties": false,
      "description": "호출이 실패했거나 답을 JSON 객체로 읽지 못했다.",
      "properties": {
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"

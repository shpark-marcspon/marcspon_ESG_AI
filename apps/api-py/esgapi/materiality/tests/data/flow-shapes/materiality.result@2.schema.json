      "additionalProperties": false,
      "description": "환경·사회 영향 하나(셀 46 — 출력 형식 절을 셀 50 꼴 JSON 으로 바꾼 impacts 의 원소).",
      "properties": {
        "impactDefinition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }

{
  "$defs": {
    "JsonValue": {},
    "MaterialityCompany": {
      "additionalProperties": false,
      "description": "기업 정보(코랩 셀 44 의 company). 1부 프롬프트에는 실리지 않는다.",
      "properties": {
        "name": {
          "description": "기업명.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "MaterialityCompany",
      "type": "object"
    },
    "MaterialityContext": {
      "additionalProperties": false,
      "description": "한 영향의 맥락(셀 50 정규화: context 가 객체가 아니면 빈 것, 두 칸이 목록이 아니면 빈 목록). 객체가 아닌 원소는\n보기에서 빼고 경고 items_skipped.",
      "properties": {
        "regulations": {
          "items": {
            "$ref": "#/$defs/MaterialityContextItem"
          },
          "title": "Regulations",
          "type": "array"
        },
        "controversies": {
          "items": {
            "$ref": "#/$defs/MaterialityContextItem"
          },
          "title": "Controversies",
          "type": "array"
        }
      },
      "required": [
        "regulations",
        "controversies"
      ],
      "title": "MaterialityContext",
      "type": "object"
    },
    "MaterialityContextItem": {
      "additionalProperties": false,
      "description": "맥락 항목 하나(셀 50 JSON 꼴 context.regulations·controversies 의 원소 {title, summary, url}). 셀 65 지시의 키\nsource 대신 셀 50 의 url 을 쓴다.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "title",
        "summary",
        "url"
      ],
      "title": "MaterialityContextItem",
      "type": "object"
    },
    "MaterialityControversyDone": {
      "additionalProperties": false,
      "description": "컨트로버시 조사(코랩 셀 22)의 답을 JSON 객체로 읽었다.",
      "properties": {
        "status": {
          "const": "done",
          "title": "Status",
          "type": "string"
        },
        "parsed": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "모델의 JSON 객체(받은 그대로). 답의 topic_name 이 입력 토픽명과 다르면 코랩대로 topic_name_expected 가 더해져\n있다.",
          "title": "Parsed",
          "type": "object"
        },
        "items": {
          "description": "parsed 에서 셀 33 규칙으로 뽑은 항목(dict 가 아닌 원소는 빼고 경고 items_skipped).",
          "items": {
            "$ref": "#/$defs/MaterialityControversyItem"
          },
          "title": "Items",
          "type": "array"
        },
        "selfCheck": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "parsed 의 self_check(객체일 때만, 아니면 null).",
          "title": "Selfcheck"
        },
        "topicNameMismatch": {
          "description": "답의 topic_name 이 입력 토픽명과 달랐는지(코랩 셀 22 의 견줌).",
          "title": "Topicnamemismatch",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "parsed",
        "items",
        "selfCheck",
        "topicNameMismatch"
      ],
      "title": "MaterialityControversyDone",
      "type": "object"
    },
    "MaterialityControversyItem": {
      "additionalProperties": false,
      "description": "컨트로버시 하나(코랩 셀 22 의 ControversyItem 에서 셀 33 의 표시 칸 차례). 모델 JSON 의 얇은 보기다.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Severity"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "region": {
          "description": "규제 항목과 칸을 맞춘 자리. 컨트로버시는 늘 null.",
          "title": "Region",
          "type": "null"
        }
      },
      "required": [
        "title",
        "date",
        "summary",
        "severity",
        "status",
        "url",
        "region"
      ],
      "title": "MaterialityControversyItem",
      "type": "object"
    },
    "MaterialityFailure": {
      "additionalProperties": false,
      "description": "호출이나 답 읽기가 실패한 까닭.",
      "properties": {
        "kind": {
          "description": "unparsable = 모델의 답을 읽지 못함(빈 답·`{` 없음·JSON 아님·꼴이 다름). 그 밖은 모델 호출의 실패 갈래(core.llm 의\n이름 그대로).",
          "enum": [
            "unparsable",
            "budget_exceeded",
            "truncated",
            "refusal",
            "provider_error",
            "timeout",
            "tool_executor_raised",
            "schema_mismatch"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "description": "실패 갈래의 설명(모델 글·공급사 메시지·고객 데이터는 싣지 않는다).",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "MaterialityFailure",
      "type": "object"
    },

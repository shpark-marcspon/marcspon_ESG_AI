{
  "$defs": {
    "MaterialityCompany": {
      "additionalProperties": false,
      "description": "기업 정보(코랩 셀 44 의 company). 1부 프롬프트에는 실리지 않는다.",
      "properties": {
        "name": {
          "description": "기업명.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "MaterialityCompany",
      "type": "object"
    },
    "MaterialityIndustry": {
      "additionalProperties": false,
      "description": "산업 하나(코랩 셀 11 industry 의 원소. 엔진에는 코랩 키 standard·industry_name·description 차례의 dict 로\n간다).",
      "properties": {
        "standard": {
          "description": "산업분류 기준(예: SASB·GICS·KSIC).",
          "title": "Standard",
          "type": "string"
        },
        "industryName": {
          "description": "산업명.",
          "title": "Industryname",
          "type": "string"
        },
        "description": {
          "description": "산업 설명.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "standard",
        "industryName",
        "description"
      ],
      "title": "MaterialityIndustry",
      "type": "object"
    },
    "MaterialityInput": {
      "additionalProperties": false,
      "description": "materiality.input@1 — 중대성평가 IRO 한 건의 입력. schemaVersion 이 첫 키다.",
      "properties": {
        "schemaVersion": {
          "const": "materiality.input@1",
          "title": "Schemaversion",
          "type": "string"
        },
        "company": {
          "$ref": "#/$defs/MaterialityCompany"
        },
        "industries": {
          "description": "산업 정의(코랩 셀 11 industry). 하나 이상.",
          "items": {
            "$ref": "#/$defs/MaterialityIndustry"
          },
          "minItems": 1,
          "title": "Industries",
          "type": "array"
        },
        "topics": {
          "description": "중대 토픽 short-list(코랩 셀 11 topics). 하나 이상, topic 이 겹치면 거절한다(코랩은 뒤 것이 덮는다).",
          "items": {
            "$ref": "#/$defs/MaterialityTopic"
          },
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        },
        "geoScope": {
          "description": "조사의 지리적 범위(코랩 location, 받은 글 그대로).",
          "title": "Geoscope",
          "type": "string"
        },
        "userLocation": {
          "description": "웹 검색의 사용자 위치(코랩 user_location, ISO 3166-1 두 글자).",
          "pattern": "^[A-Z]{2}$",
          "title": "Userlocation",
          "type": "string"
        },
        "mainLanguage": {
          "description": "검색에 우선 쓸 언어(코랩 main_language).",
          "title": "Mainlanguage",
          "type": "string"
        },
        "dateRange": {
          "description": "조사 기간(코랩 date_range, 받은 글 그대로). 코랩대로 키워드 호출에만 간다.",
          "title": "Daterange",
          "type": "string"
        },
        "sector": {
          "enum": [
            "financial",
            "non_financial"
          ],
          "title": "Sector",
          "type": "string"
        },
        "latestEventMode": {
          "description": "2부의 서브토픽 영향 정의에서 웹 검색을 켤지(코랩 셀 44 latest_event_mode). 1부는 쓰지 않고 scope 에 남긴다.",
          "title": "Latesteventmode",
          "type": "boolean"
        },
        "subtopicsByTopic": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/MaterialitySubtopic"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "토픽명 → 서브토픽 목록(코랩 셀 44). 2부 몫. 없는 토픽은 2부가 토픽 설명으로 하나 지어 넣는다.",
          "title": "Subtopicsbytopic"
        },
        "valueChain": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MaterialityValueChainRow"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "가치사슬 활동 목록(코랩 셀 44 value_chain, MARC-ENT-421 의 선택 칸). 2부 몫.",
          "title": "Valuechain"
        }
      },
      "required": [
        "schemaVersion",
        "company",
        "industries",
        "topics",
        "geoScope",
        "userLocation",
        "mainLanguage",
        "dateRange",
        "sector",
        "latestEventMode",
        "subtopicsByTopic",
        "valueChain"
      ],
      "title": "MaterialityInput",
      "type": "object"
    },
    "MaterialitySubtopic": {
      "additionalProperties": false,
      "description": "서브토픽 하나(코랩 셀 44 subtopics_by_topic 의 원소).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "MaterialitySubtopic",
      "type": "object"
    },
    "MaterialityTopic": {
      "additionalProperties": false,
      "description": "중대 토픽 하나(코랩 셀 11 topics 의 원소).",
      "properties": {
        "topic": {
          "description": "토픽명. 입력 안에서 겹치지 않는다.",
          "title": "Topic",
          "type": "string"
        },
        "description": {
          "description": "토픽 설명(서브토픽을 모두 포괄하게).",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "description"
      ],
      "title": "MaterialityTopic",
      "type": "object"
    },
    "MaterialityValueChainRow": {
      "additionalProperties": false,
      "description": "가치사슬 한 행(코랩 셀 44 value_chain 의 원소, 코랩 키 그대로 — MARC-ENT-421).",
      "properties": {
        "business_unit": {
          "title": "Business Unit",
          "type": "string"
        },
        "business_unit_description": {
          "title": "Business Unit Description",
          "type": "string"
        },
        "value_chain_stage": {
          "title": "Value Chain Stage",
          "type": "string"
        },
        "stakeholder": {
          "title": "Stakeholder",
          "type": "string"
        },
        "business_activity": {
          "title": "Business Activity",
          "type": "string"
        }
      },
      "required": [
        "business_unit",
        "business_unit_description",
        "value_chain_stage",
        "stakeholder",
        "business_activity"
      ],
      "title": "MaterialityValueChainRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "materiality.options@1 — 중대성평가 IRO 실행의 옵션.",
  "properties": {
    "input": {
      "$ref": "#/$defs/MaterialityInput",
      "description": "조사할 입력(materiality.input@1 — 받은 그대로 흐름에 넘긴다)."
    }
  },
  "required": [
    "input"
  ],
  "title": "MaterialityOptions",
  "type": "object"
}

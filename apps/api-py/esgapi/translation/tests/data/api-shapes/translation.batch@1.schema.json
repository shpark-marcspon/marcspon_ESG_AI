{
  "$defs": {
    "DigestFiles": {
      "additionalProperties": false,
      "description": "그 문체의 Word 세 갈래 — 실행이 실제로 지은 출력 파일 이름, 짓지 않았으면(검수 멈춤·자동수정 안 돎·Word 짓기\n실패) null. 이름은 그 실행의 출력 파일 이름 그대로다(`translation-<갈래>-<문체 소문자>.docx`).",
      "properties": {
        "bilingual": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bilingual"
        },
        "qa": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qa"
        },
        "autofix": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Autofix"
        }
      },
      "required": [
        "bilingual",
        "qa",
        "autofix"
      ],
      "title": "DigestFiles",
      "type": "object"
    },
    "DigestVariant": {
      "additionalProperties": false,
      "description": "문체 하나의 요약.",
      "properties": {
        "label": {
          "enum": [
            "single",
            "A",
            "B"
          ],
          "title": "Label",
          "type": "string"
        },
        "reviewStatus": {
          "description": "reviewed = 모든 쪽의 검수가 돌았다(parse_failed 쪽 포함), call_failed·not_run = 쪽 차례로 처음 멈춘 쪽의 검수\nstatus.",
          "enum": [
            "reviewed",
            "call_failed",
            "not_run"
          ],
          "title": "Reviewstatus",
          "type": "string"
        },
        "reviewStoppedAt": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "검수가 처음 멈춘 쪽 번호. reviewed 면 null.",
          "title": "Reviewstoppedat"
        },
        "parseFailedPages": {
          "description": "검수 답을 JSON 으로 못 읽은 쪽 수(결과 review.status parse_failed — 모델 이슈 0 으로 친 쪽).",
          "minimum": 0,
          "title": "Parsefailedpages",
          "type": "integer"
        },
        "issueCount": {
          "description": "그 문체의 검수 이슈 수(쪽마다 review.issues 길이의 합 — 심각도 글자와 무관).",
          "minimum": 0,
          "title": "Issuecount",
          "type": "integer"
        },
        "issueCounts": {
          "$ref": "#/$defs/SeverityCounts",
          "description": "심각도별 이슈 수(쪽마다 review.counts 의 합 — 글자가 정확히 HIGH·MEDIUM·LOW 인 것만이라 합은 issueCount 이하)."
        },
        "glossaryMisses": {
          "description": "용어집 미반영 줄 수 — 결과 glossaryCheck 가운데 번역 대상 쪽(document.pageNumbers)의 줄만.",
          "minimum": 0,
          "title": "Glossarymisses",
          "type": "integer"
        },
        "autofixStatus": {
          "enum": [
            "done",
            "stopped",
            "not_run"
          ],
          "title": "Autofixstatus",
          "type": "string"
        },
        "autofixChangedPages": {
          "description": "자동수정이 글을 바꾼 쪽 수(autofix.pages 의 changed). 끝까지 안 돌았으면 0.",
          "minimum": 0,
          "title": "Autofixchangedpages",
          "type": "integer"
        },
        "files": {
          "$ref": "#/$defs/DigestFiles"
        }
      },
      "required": [
        "label",
        "reviewStatus",
        "reviewStoppedAt",
        "parseFailedPages",
        "issueCount",
        "issueCounts",
        "glossaryMisses",
        "autofixStatus",
        "autofixChangedPages",
        "files"
      ],
      "title": "DigestVariant",
      "type": "object"
    },
    "SeverityCounts": {
      "additionalProperties": false,
      "description": "심각도별 이슈 수(코랩 QA Word 요약표의 셈 — 글자가 정확히 HIGH·MEDIUM·LOW 인 것만).",
      "properties": {
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "medium": {
          "minimum": 0,
          "title": "Medium",
          "type": "integer"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        }
      },
      "required": [
        "high",
        "medium",
        "low"
      ],
      "title": "SeverityCounts",
      "type": "object"
    },
    "TranslationBatch": {
      "additionalProperties": false,
      "description": "translation.batch@1 — 문서 하나의 묶음 하나.",
      "properties": {
        "batchKey": {
          "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|run-[1-9][0-9]*)$",
          "title": "Batchkey",
          "type": "string"
        },
        "inputKind": {
          "description": "묶음 안 가장 새 실행의 흐름 id 가 translation.pdf@ 로 시작하면 pdf, 아니면 word(옛 실행 포함 — 밴드 TRS3).",
          "enum": [
            "word",
            "pdf"
          ],
          "title": "Inputkind",
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/TranslationBatchDocument"
        },
        "createdBy": {
          "$ref": "#/$defs/TranslationBatchPerson",
          "description": "묶음 안 가장 새 실행을 만든 사람."
        },
        "parts": {
          "description": "ceo_message·story·general 차례, 실행이 있는 파트만.",
          "items": {
            "$ref": "#/$defs/TranslationBatchPart"
          },
          "title": "Parts",
          "type": "array"
        },
        "state": {
          "description": "파트 최신 실행만 본다. active = queued·processing 하나라도 · failed = 그 밖에 failed 실행이나 요약 outcome\nrejected·partial 하나라도 · done = 그 밖(요약이 없는 옛 done 실행 포함).",
          "enum": [
            "active",
            "done",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "doneParts": {
          "description": "최신 실행이 done 인 파트 수.",
          "minimum": 0,
          "title": "Doneparts",
          "type": "integer"
        },
        "partCount": {
          "description": "parts 길이.",
          "minimum": 1,
          "title": "Partcount",
          "type": "integer"
        }
      },
      "required": [
        "batchKey",
        "inputKind",
        "document",
        "createdBy",
        "parts",
        "state",
        "doneParts",
        "partCount"
      ],
      "title": "TranslationBatch",
      "type": "object"
    },
    "TranslationBatchDocument": {
      "additionalProperties": false,
      "description": "묶음의 문서.",
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "fileName": {
          "title": "Filename",
          "type": "string"
        },
        "uploadedAt": {
          "anyOf": [
            {
              "description": "ISO 8601(서울 시각, 오프셋 포함)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "올림을 마친 시각. 아직 안 마쳤으면 null.",
          "title": "Uploadedat"
        },
        "uploadedBy": {
          "$ref": "#/$defs/TranslationBatchPerson"
        }
      },
      "required": [
        "id",
        "fileName",
        "uploadedAt",
        "uploadedBy"
      ],
      "title": "TranslationBatchDocument",
      "type": "object"
    },
    "TranslationBatchEarlier": {
      "additionalProperties": false,
      "description": "같은 파트의 앞 실행 하나(회차 펼침).",
      "properties": {
        "runId": {
          "minimum": 1,
          "title": "Runid",
          "type": "integer"
        },
        "status": {
          "enum": [
            "queued",
            "processing",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "createdAt": {
          "description": "ISO 8601(서울 시각, 오프셋 포함)",
          "title": "Createdat",
          "type": "string"
        },
        "finishedAt": {
          "anyOf": [
            {
              "description": "ISO 8601(서울 시각, 오프셋 포함)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finishedat"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "done",
                "partial",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "그 실행 요약의 outcome. 끝나지 않았거나 요약이 없으면 null.",
          "title": "Outcome"
        }
      },
      "required": [
        "runId",
        "status",
        "createdAt",
        "finishedAt",
        "outcome"
      ],
      "title": "TranslationBatchEarlier",
      "type": "object"
    },
    "TranslationBatchGlossaryCounts": {
      "additionalProperties": false,
      "description": "옵션 용어집의 짝 수. final 이 화면의 「고객사 용어집 n개」다.",
      "properties": {
        "base": {
          "minimum": 0,
          "title": "Base",
          "type": "integer"
        },
        "final": {
          "minimum": 0,
          "title": "Final",
          "type": "integer"
        }
      },
      "required": [
        "base",
        "final"
      ],
      "title": "TranslationBatchGlossaryCounts",
      "type": "object"
    },
    "TranslationBatchPages": {
      "additionalProperties": false,
      "description": "번역할 쪽 범위(옵션 pages 그대로 — contracts/shapes.py PageRange). null 이면 그쪽 끝이 열린다.",
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TranslationBatchPages",
      "type": "object"
    },
    "TranslationBatchPart": {
      "additionalProperties": false,
      "description": "묶음의 파트 하나.",
      "properties": {
        "part": {
          "enum": [
            "ceo_message",
            "story",
            "general"
          ],
          "title": "Part",
          "type": "string"
        },
        "latest": {
          "$ref": "#/$defs/TranslationBatchRun"
        },
        "earlier": {
          "description": "같은 파트의 앞 실행(새 것 먼저).",
          "items": {
            "$ref": "#/$defs/TranslationBatchEarlier"
          },
          "title": "Earlier",
          "type": "array"
        },
        "round": {
          "description": "회차 = earlier 수 + 1.",
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "part",
        "latest",
        "earlier",
        "round"
      ],
      "title": "TranslationBatchPart",
      "type": "object"
    },
    "TranslationBatchPerson": {
      "additionalProperties": false,
      "description": "사람 — id 와 지금 이름(지운·모르는 사람이면 「알 수 없는 사용자」).",
      "properties": {
        "userId": {
          "description": "사용자 id. 문서 올린 사람 칸이 숫자가 아니면 0.",
          "minimum": 0,
          "title": "Userid",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "userId",
        "name"
      ],
      "title": "TranslationBatchPerson",
      "type": "object"
    },
    "TranslationBatchRun": {
      "additionalProperties": false,
      "description": "파트의 최신 실행.",
      "properties": {
        "runId": {
          "minimum": 1,
          "title": "Runid",
          "type": "integer"
        },
        "flowId": {
          "description": "그 실행의 흐름 id 그대로(예: translation.colab@158 · translation.pdf@158 — 밴드 TRS3).",
          "title": "Flowid",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "processing",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslationBatchPages"
            },
            {
              "type": "null"
            }
          ],
          "description": "옵션의 쪽 범위. 옵션 꼴이 어긋나면 null."
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslationBatchStyle"
            },
            {
              "type": "null"
            }
          ],
          "description": "옵션의 문체. 옵션 꼴이 어긋나면 null."
        },
        "glossaryCounts": {
          "$ref": "#/$defs/TranslationBatchGlossaryCounts"
        },
        "createdAt": {
          "description": "ISO 8601(서울 시각, 오프셋 포함)",
          "title": "Createdat",
          "type": "string"
        },
        "startedAt": {
          "anyOf": [
            {
              "description": "ISO 8601(서울 시각, 오프셋 포함)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Startedat"
        },
        "finishedAt": {
          "anyOf": [
            {
              "description": "ISO 8601(서울 시각, 오프셋 포함)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finishedat"
        },
        "failedStep": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "failed 실행이 멈춘 단계(실행기의 실패면 null). failed 가 아니면 null.",
          "title": "Failedstep"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "failed 실행의 오류 code. failed 가 아니면 null.",
          "title": "Errorcode"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TranslationBatchStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslationDigest"
            },
            {
              "type": "null"
            }
          ],
          "description": "끝난 실행의 요약(translation.digest@1). 끝나지 않았거나 요약을 남기기 전의 옛 실행이면 null — 「모름」이다."
        }
      },
      "required": [
        "runId",
        "flowId",
        "status",
        "pages",
        "style",
        "glossaryCounts",
        "createdAt",
        "startedAt",
        "finishedAt",
        "failedStep",
        "errorCode",
        "steps",
        "digest"
      ],
      "title": "TranslationBatchRun",
      "type": "object"
    },
    "TranslationBatchStep": {
      "additionalProperties": false,
      "description": "실행의 단계 하나(GET /runs/{id} 의 steps 와 같은 값 — 선언 차례).",
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "done": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Done"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total"
        }
      },
      "required": [
        "step",
        "status",
        "done",
        "total"
      ],
      "title": "TranslationBatchStep",
      "type": "object"
    },
    "TranslationBatchStyle": {
      "additionalProperties": false,
      "description": "번역 문체(옵션 style 그대로 — contracts/shapes.py Style).",
      "properties": {
        "compareAb": {
          "title": "Compareab",
          "type": "boolean"
        },
        "single": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Single",
          "type": "string"
        }
      },
      "required": [
        "compareAb",
        "single"
      ],
      "title": "TranslationBatchStyle",
      "type": "object"
    },
    "TranslationDigest": {
      "additionalProperties": false,
      "description": "translation.digest@1 — 영문번역 실행 하나의 요약.",
      "properties": {
        "schemaVersion": {
          "const": "translation.digest@1",
          "title": "Schemaversion",
          "type": "string"
        },
        "status": {
          "description": "결과 translation.result@1 의 status.",
          "enum": [
            "done",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "rejectionKind": {
          "anyOf": [
            {
              "enum": [
                "no_pages",
                "ceo_page_limit",
                "unsupported_input",
                "too_large",
                "over_budget",
                "retry_source_not_found",
                "retry_source_mismatch"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "rejected 면 결과 rejection.kind, 아니면 null. 거절 글은 결과 경로의 rejection.message 에 있다.",
          "title": "Rejectionkind"
        },
        "outcome": {
          "description": "rejected = 번역을 시작하지 않음, partial = 번역 못 한 쪽이 하나라도 있거나(failedPages) 어느 문체의 검수가\n멈춤(call_failed·not_run), done = 그 밖. 자동수정 멈춤·검수 parse_failed 는 partial 로 치지 않는다.",
          "enum": [
            "done",
            "partial",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "pageCount": {
          "description": "번역 대상 쪽 수(document.pageNumbers 의 서로 다른 번호).",
          "minimum": 0,
          "title": "Pagecount",
          "type": "integer"
        },
        "failedPages": {
          "description": "어느 문체에서든 번역이 실패한 쪽 번호(fragments status error — 오름차순, 겹침 없음).",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Failedpages",
          "type": "array"
        },
        "variants": {
          "description": "결과의 문체 차례 그대로. rejected 면 빈 목록.",
          "items": {
            "$ref": "#/$defs/DigestVariant"
          },
          "title": "Variants",
          "type": "array"
        },
        "warningCount": {
          "description": "결과 warnings 의 줄 수.",
          "minimum": 0,
          "title": "Warningcount",
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "rejectionKind",
        "outcome",
        "pageCount",
        "failedPages",
        "variants",
        "warningCount"
      ],
      "title": "TranslationDigest",
      "type": "object"
    }
  },
  "$ref": "#/$defs/TranslationBatch",
  "description": "영문번역 묶음 하나.",
  "title": "translation.batch@1"
}

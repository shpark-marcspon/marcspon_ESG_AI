{
  "$defs": {
    "ByNameItems": {
      "additionalProperties": false,
      "description": "이름형 도구(*_by_name·*_by_names)가 받은 항목(모델이 준 JSON 값 그대로 — 보통 [대분류, 중분류, 소분류, 단위]\n배열, addends 는 그 배열의 목록). 도구마다 쓰는 열쇠만 있다: sum_check_by_name = total·a·b,\nsum_n_check_by_names = addends·target, ratio_check_by_name = numerator·denominator·expected.",
      "properties": {
        "total": {
          "$ref": "#/$defs/JsonValue"
        },
        "a": {
          "$ref": "#/$defs/JsonValue"
        },
        "b": {
          "$ref": "#/$defs/JsonValue"
        },
        "addends": {
          "$ref": "#/$defs/JsonValue"
        },
        "target": {
          "$ref": "#/$defs/JsonValue"
        },
        "numerator": {
          "$ref": "#/$defs/JsonValue"
        },
        "denominator": {
          "$ref": "#/$defs/JsonValue"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "ByNameItems",
      "type": "object"
    },
    "CheckItems": {
      "additionalProperties": false,
      "description": "검사에 쓴 항목. 어느 쪽인지는 tool 로 가른다 — 이름형 도구는 byName, 단건 도구는 raw 이고 다른 쪽은 null.",
      "properties": {
        "byName": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByNameItems"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawItems"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "byName",
        "raw"
      ],
      "title": "CheckItems",
      "type": "object"
    },
    "Company": {
      "additionalProperties": false,
      "description": "기업 정보(코랩 셀 10·18 USER 의 「기업 정보」 네 줄).",
      "properties": {
        "name": {
          "description": "기업명.",
          "title": "Name",
          "type": "string"
        },
        "sasbIndustry": {
          "description": "SASB 산업분류.",
          "title": "Sasbindustry",
          "type": "string"
        },
        "materialTopics": {
          "description": "주요 중대토픽. 프롬프트에는 「, 」로 이어 한 줄로 싣는다(코랩대로).",
          "items": {
            "type": "string"
          },
          "title": "Materialtopics",
          "type": "array"
        },
        "reportingYear": {
          "description": "보고연도(YYYY).",
          "pattern": "^[0-9]{4}$",
          "title": "Reportingyear",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sasbIndustry",
        "materialTopics",
        "reportingYear"
      ],
      "title": "Company",
      "type": "object"
    },
    "DataverifyResult": {
      "additionalProperties": false,
      "description": "dataverify.result@2 — 데이터 검증 한 건의 결과. schemaVersion 이 첫 키다. 사용량·비용은 싣지 않는다(실행기의\n기록이 진실이다).",
      "properties": {
        "schemaVersion": {
          "const": "dataverify.result@2",
          "title": "Schemaversion",
          "type": "string"
        },
        "company": {
          "$ref": "#/$defs/Company",
          "description": "입력의 company 그대로."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "settings": {
          "$ref": "#/$defs/DataverifySettings"
        },
        "plan": {
          "discriminator": {
            "mapping": {
              "done": "#/$defs/PlanDone",
              "failed": "#/$defs/PlanFailed",
              "not_run": "#/$defs/PlanNotRun"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PlanDone"
            },
            {
              "$ref": "#/$defs/PlanFailed"
            },
            {
              "$ref": "#/$defs/PlanNotRun"
            }
          ],
          "title": "Plan"
        },
        "review": {
          "discriminator": {
            "mapping": {
              "done": "#/$defs/DataverifyReviewDone",
              "failed": "#/$defs/ReviewFailed",
              "not_run": "#/$defs/ReviewNotRun"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DataverifyReviewDone"
            },
            {
              "$ref": "#/$defs/ReviewFailed"
            },
            {
              "$ref": "#/$defs/ReviewNotRun"
            }
          ],
          "title": "Review"
        },
        "insight": {
          "discriminator": {
            "mapping": {
              "done": "#/$defs/InsightDone",
              "failed": "#/$defs/InsightFailed",
              "not_run": "#/$defs/InsightNotRun"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/InsightDone"
            },
            {
              "$ref": "#/$defs/InsightFailed"
            },
            {
              "$ref": "#/$defs/InsightNotRun"
            }
          ],
          "title": "Insight"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/DataverifyWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "company",
        "scope",
        "settings",
        "plan",
        "review",
        "insight",
        "warnings"
      ],
      "title": "DataverifyResult",
      "type": "object"
    },
    "DataverifyReviewDone": {
      "additionalProperties": false,
      "description": "계산 검토(코랩2번)를 마쳤다.",
      "properties": {
        "status": {
          "const": "done",
          "title": "Status",
          "type": "string"
        },
        "partial": {
          "description": "true = 최대 횟수에 닿아 남은 도구 호출을 버리고 마지막 답을 썼다, false = 고리가 끝까지 돌았다.",
          "title": "Partial",
          "type": "boolean"
        },
        "report": {
          "description": "검토 리포트 원문(모델의 글).",
          "title": "Report",
          "type": "string"
        },
        "checks": {
          "description": "도구 호출 기록(호출 차례).",
          "items": {
            "discriminator": {
              "mapping": {
                "check": "#/$defs/RuleCheck",
                "error": "#/$defs/ErrorCheck",
                "search": "#/$defs/SearchCheck",
                "value": "#/$defs/ValueCheck"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ValueCheck"
              },
              {
                "$ref": "#/$defs/RuleCheck"
              },
              {
                "$ref": "#/$defs/SearchCheck"
              },
              {
                "$ref": "#/$defs/ErrorCheck"
              }
            ]
          },
          "title": "Checks",
          "type": "array"
        },
        "failure": {
          "title": "Failure",
          "type": "null"
        }
      },
      "required": [
        "status",
        "partial",
        "report",
        "checks",
        "failure"
      ],
      "title": "DataverifyReviewDone",
      "type": "object"
    },
    "DataverifySettings": {
      "additionalProperties": false,
      "description": "실행 설정(코랩 셀 10·14·18 의 상수). 실제로 불린 모델·사용량은 실행기의 기록이 진실이다.",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "모델 이름(코랩 설정). 모델을 부르지 않았으면 null.",
          "title": "Model"
        },
        "tolerance": {
          "description": "검사 도구의 허용 오차(repr(float) 글자. 코랩 1.1).",
          "title": "Tolerance",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "모델의 temperature(repr(float) 글자). 모델을 부르지 않았으면 null.",
          "title": "Temperature"
        },
        "maxSteps": {
          "$ref": "#/$defs/MaxSteps"
        },
        "promptIds": {
          "$ref": "#/$defs/PromptIds"
        }
      },
      "required": [
        "model",
        "tolerance",
        "temperature",
        "maxSteps",
        "promptIds"
      ],
      "title": "DataverifySettings",
      "type": "object"
    },
    "DataverifyWarning": {
      "additionalProperties": false,
      "description": "경고 한 줄.",
      "properties": {
        "code": {
          "description": "경고의 종류(예: no_target_theme = 입력에 테마 「환경」이 없다).",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "DataverifyWarning",
      "type": "object"
    },
    "ErrorCheck": {
      "additionalProperties": false,
      "description": "도구가 오류를 돌려준 호출(모르는 도구·인자 틀림·도구 안의 예외). 또는 도구 출력이 이 꼴에 맞지 않은 호출 —\n엔진의 결함일 때만이고 메시지가 「shape mismatch: 」로 시작한다.",
      "properties": {
        "seq": {
          "description": "검토 단계의 도구 호출 차례(1부터).",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "kind": {
          "const": "error",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "description": "오류 글(도구의 error 글 그대로, 꼴이 맞지 않으면 그 까닭).",
          "title": "Message",
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/JsonValue",
          "description": "모델이 준 인자 그대로(보통 객체, 객체가 아니어도 그대로)."
        }
      },
      "required": [
        "seq",
        "tool",
        "kind",
        "message",
        "args"
      ],
      "title": "ErrorCheck",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "단계가 실패한 까닭.",
      "properties": {
        "kind": {
          "description": "unparsable = 모델의 답을 읽지 못함(계산 Plan 이 python list 가 아님). 그 밖은 모델 호출의 실패 갈래(core.llm 의\n이름 그대로): budget_exceeded = 비용 상한, truncated = 출력이 잘림, refusal = 모델이 거절, provider_error = 공급사\n오류, timeout = 시간 한도, tool_executor_raised = 도구 실행이 예외를 던짐, schema_mismatch = 답이 스키마에 맞지\n않음.",
          "enum": [
            "unparsable",
            "budget_exceeded",
            "truncated",
            "refusal",
            "provider_error",
            "timeout",
            "tool_executor_raised",
            "schema_mismatch"
          ],
          "title": "Kind",
          "type": "string"
        },
        "budgetSource": {
          "anyOf": [
            {
              "enum": [
                "guard",
                "loop"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "budget_exceeded 일 때만 값: guard = 기존 비용 상한(BudgetLimit), loop = 단계 고리 한 번의 상한(max_cost_usd).\n그 밖의 갈래는 null.",
          "title": "Budgetsource"
        },
        "message": {
          "description": "실패 갈래와 상한의 자리·공급사 상태 번호·도구 이름까지(모델 글·공급사 메시지·고객 데이터는 싣지 않는다).",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "budgetSource",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "InsightDone": {
      "additionalProperties": false,
      "description": "인사이트(코랩3번)를 마쳤다.",

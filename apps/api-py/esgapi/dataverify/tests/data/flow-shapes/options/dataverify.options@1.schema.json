{
  "$defs": {
    "Company": {
      "additionalProperties": false,
      "description": "기업 정보(코랩 셀 10·18 USER 의 「기업 정보」 네 줄).",
      "properties": {
        "name": {
          "description": "기업명.",
          "title": "Name",
          "type": "string"
        },
        "sasbIndustry": {
          "description": "SASB 산업분류.",
          "title": "Sasbindustry",
          "type": "string"
        },
        "materialTopics": {
          "description": "주요 중대토픽. 프롬프트에는 「, 」로 이어 한 줄로 싣는다(코랩대로).",
          "items": {
            "type": "string"
          },
          "title": "Materialtopics",
          "type": "array"
        },
        "reportingYear": {
          "description": "보고연도(YYYY).",
          "pattern": "^[0-9]{4}$",
          "title": "Reportingyear",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sasbIndustry",
        "materialTopics",
        "reportingYear"
      ],
      "title": "Company",
      "type": "object"
    },
    "DataverifyFileSource": {
      "additionalProperties": false,
      "description": "올린 파일에서 읽은 입력.",
      "properties": {
        "kind": {
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "파일 이름(경로 없이 — 웹이 뗀다). 표시 전용, 받은 그대로 둔다.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "DataverifyFileSource",
      "type": "object"
    },
    "DataverifyInput": {
      "additionalProperties": false,
      "description": "dataverify.input@1 — 데이터 검증 한 건의 입력. schemaVersion 이 첫 키다.",
      "properties": {
        "schemaVersion": {
          "const": "dataverify.input@1",
          "title": "Schemaversion",
          "type": "string"
        },
        "company": {
          "$ref": "#/$defs/Company"
        },
        "data": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/EdkItem"
            },
            "type": "array"
          },
          "description": "테마 이름 → 항목 목록(코랩 셀 2 의 data 그대로). 검증 대상은 테마 「환경」뿐이다(코랩 셀 3).",
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "company",
        "data"
      ],
      "title": "DataverifyInput",
      "type": "object"
    },
    "DataverifyPasteSource": {
      "additionalProperties": false,
      "description": "붙여 넣은 입력. 이름이 없다(주면 모르는 열쇠로 거절).",
      "properties": {
        "kind": {
          "const": "paste",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DataverifyPasteSource",
      "type": "object"
    },
    "EdkItem": {
      "additionalProperties": true,
      "properties": {
        "ID": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "테마": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "테마"
        },
        "항목": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "항목"
        },
        "대분류": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "대분류"
        },
        "중분류": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "중분류"
        },
        "소분류": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "소분류"
        },
        "입력 방식": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "입력 방식"
        },
        "단위": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "단위"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "핵심데이터": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "핵심데이터"
        },
        "메모": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "메모"
        }
      },
      "required": [
        "ID",
        "테마",
        "항목",
        "대분류",
        "중분류",
        "소분류",
        "입력 방식",
        "단위",
        "values",
        "핵심데이터",
        "메모"
      ],
      "title": "EdkItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "dataverify.options@1 — 데이터 검증 실행의 옵션.",
  "properties": {
    "input": {
      "$ref": "#/$defs/DataverifyInput",
      "description": "검증할 입력(dataverify.input@1 — 받은 그대로 흐름에 넘긴다)."
    },
    "source": {
      "description": "입력의 출처(표시 전용 — 흐름에 넘기지 않는다). 없으면 알 수 없음(옛 본문).",
      "discriminator": {
        "mapping": {
          "file": "#/$defs/DataverifyFileSource",
          "paste": "#/$defs/DataverifyPasteSource"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DataverifyFileSource"
        },
        {
          "$ref": "#/$defs/DataverifyPasteSource"
        }
      ],
      "title": "Source"
    }
  },
  "required": [
    "input"
  ],
  "title": "DataverifyOptions",
  "type": "object"
}

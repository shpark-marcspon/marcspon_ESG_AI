{
  "$defs": {
    "GreenwashCheckDocument": {
      "additionalProperties": false,
      "description": "그린워싱 실행이 하나라도 있는 문서 하나.",
      "properties": {
        "documentId": {
          "title": "Documentid",
          "type": "integer"
        },
        "fileName": {
          "description": "올린 파일의 이름.",
          "title": "Filename",
          "type": "string"
        },
        "reportYear": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "보고 연도(문서의 칸). 비어 있으면 null.",
          "title": "Reportyear"
        },
        "previousDocumentId": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "수정본이면 앞 판 문서 id(문서의 칸). 비어 있으면 null.",
          "title": "Previousdocumentid"
        },
        "pageCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "쪽 수(그 문서의 끝난 실행 결과에서). 모르면 null.",
          "title": "Pagecount"
        },
        "uploadedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "올린 때(+09:00 ISO 8601). 올림 확인 전이면 null.",
          "title": "Uploadedat"
        },
        "uploadedBy": {
          "$ref": "#/$defs/GreenwashCheckUploader",
          "description": "올린 사람."
        }
      },
      "required": [
        "documentId",
        "fileName",
        "reportYear",
        "previousDocumentId",
        "pageCount",
        "uploadedAt",
        "uploadedBy"
      ],
      "title": "GreenwashCheckDocument",
      "type": "object"
    },
    "GreenwashCheckReview": {
      "additionalProperties": false,
      "description": "끝난 실행의 검토 요약.",
      "properties": {
        "state": {
          "enum": [
            "pending",
            "in_review",
            "confirmed"
          ],
          "title": "State",
          "type": "string"
        },
        "reviewed": {
          "description": "표시한 문장 수.",
          "minimum": 0,
          "title": "Reviewed",
          "type": "integer"
        },
        "total": {
          "description": "결과의 문장 수.",
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "확정한 때(+09:00 ISO 8601). 확정 전이면 null.",
          "title": "Confirmedat"
        },
        "confirmedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenwashReviewer"
            },
            {
              "type": "null"
            }
          ],
          "description": "확정한 사람. 확정 전이면 null."
        }
      },
      "required": [
        "state",
        "reviewed",
        "total",
        "confirmedAt",
        "confirmedBy"
      ],
      "title": "GreenwashCheckReview",
      "type": "object"
    },
    "GreenwashCheckRun": {
      "additionalProperties": false,
      "description": "그린워싱 실행 하나.",
      "properties": {
        "runId": {
          "title": "Runid",
          "type": "integer"
        },
        "documentId": {
          "title": "Documentid",
          "type": "integer"
        },
        "createdAt": {
          "description": "만든 때(+09:00 ISO 8601).",
          "title": "Createdat",
          "type": "string"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "끝난 때(+09:00 ISO 8601). done·failed 로 끝났을 때만, 그 밖 null(runs 의 finished_at 그대로).",
          "title": "Finishedat"
        },
        "createdByUserId": {
          "description": "실행을 만든 사용자 id.",
          "title": "Createdbyuserid",
          "type": "integer"
        },
        "status": {
          "enum": [
            "queued",
            "processing",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "실패 까닭 code(실행 기록 그대로 — no_text_layer·step_error·attempts_exhausted 등). failed 일 때만, 그 밖 null.",
          "title": "Errorcode"
        },
        "failedPageCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "읽지 못한 쪽 수(결과 candidateStats.failedPages 의 수 — 쪽·까닭은 결과에). 끝난 실행만(dry-run 은 null).",
          "title": "Failedpagecount"
        },
        "steps": {
          "description": "단계(선언 차례).",
          "items": {
            "$ref": "#/$defs/GreenwashCheckStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "checkedPages": {
          "description": "점검할 쪽 수(옵션 parts 셋의 합집합).",
          "minimum": 0,
          "title": "Checkedpages",
          "type": "integer"
        },
        "levelCounts": {
          "anyOf": [
            {
              "$ref": "#/$defs/LevelCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "결과의 등급별 문장 수 — 효력 등급(검토에서 고친 등급 ?? AI 등급)으로 센다. 끝난 실행만."
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenwashCheckReview"
            },
            {
              "type": "null"
            }
          ],
          "description": "검토 요약. 끝난 실행만(dry-run 실행은 null)."
        }
      },
      "required": [
        "runId",
        "documentId",
        "createdAt",
        "finishedAt",
        "createdByUserId",
        "status",
        "errorCode",
        "failedPageCount",
        "steps",
        "checkedPages",
        "levelCounts",
        "review"
      ],
      "title": "GreenwashCheckRun",
      "type": "object"
    },
    "GreenwashCheckStep": {
      "additionalProperties": false,
      "description": "실행 단계 하나(GET /runs/{id} 의 steps 와 같은 꼴).",
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "done": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Done"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total"
        }
      },
      "required": [
        "step",
        "status",
        "done",
        "total"
      ],
      "title": "GreenwashCheckStep",
      "type": "object"
    },
    "GreenwashCheckUploader": {
      "additionalProperties": false,
      "description": "문서를 올린 사람.",
      "properties": {
        "userId": {
          "description": "사용자 id.",
          "title": "Userid",
          "type": "integer"
        },
        "name": {
          "description": "화면에 보일 이름. 못 풀면 「알 수 없는 사용자」.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "userId",
        "name"
      ],
      "title": "GreenwashCheckUploader",
      "type": "object"
    },
    "GreenwashReviewer": {
      "additionalProperties": false,
      "description": "확정한 사람. 응답 전용(본문에 오지 않는다 — 사람은 세션에서 온다).",
      "properties": {
        "id": {
          "description": "사용자 id(int). 세션의 user_id(글자)를 int 로 바꾸는 것은 G1b 몫이다.",
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "description": "화면에 보일 이름(빈 글자 아님).",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "GreenwashReviewer",
      "type": "object"
    },
    "LevelCounts": {
      "additionalProperties": false,
      "description": "등급별 문장 수.",
      "properties": {
        "High": {
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "Mid": {
          "minimum": 0,
          "title": "Mid",
          "type": "integer"
        },
        "Low": {
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        }
      },
      "required": [
        "High",
        "Mid",
        "Low"
      ],
      "title": "LevelCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "greenwash.checks@1 — 그린워싱 문서 목록의 원재료. schemaVersion 이 첫 키다.",
  "properties": {
    "schemaVersion": {
      "const": "greenwash.checks@1",
      "title": "Schemaversion",
      "type": "string"
    },
    "currentUserId": {
      "description": "지금 사용자 id(「내가 올린 것만」 거르기).",
      "title": "Currentuserid",
      "type": "integer"
    },
    "companyName": {
      "description": "회사 이름.",
      "title": "Companyname",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/GreenwashCheckDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/GreenwashCheckRun"
      },
      "title": "Runs",
      "type": "array"
    },
    "truncated": {
      "description": "실행이 RUNS_MAX(1000)를 넘어 오래된 것이 빠졌으면 true(새 것 먼저 RUNS_MAX 까지 싣는다).",
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "currentUserId",
    "companyName",
    "documents",
    "runs",
    "truncated"
  ],
  "title": "GreenwashChecks",
  "type": "object"
}

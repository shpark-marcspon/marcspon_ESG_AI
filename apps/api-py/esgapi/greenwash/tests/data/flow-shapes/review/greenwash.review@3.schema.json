{
  "$defs": {
    "GreenwashEvidenceAdded": {
      "additionalProperties": false,
      "description": "사람이 더한 근거 조각.",
      "properties": {
        "text": {
          "description": "조각 글(앞뒤 공백을 지운 1~1,000자 — 서버가 다듬어 저장한다).",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "조각이 나온 쪽(1부터). 고르지 않았으면 null.",
          "title": "Page"
        }
      },
      "required": [
        "text",
        "page"
      ],
      "title": "GreenwashEvidenceAdded",
      "type": "object"
    },
    "GreenwashRejudged": {
      "additionalProperties": false,
      "description": "기준 판단(가장 늦게 끝난 재판단의 판단). 칸 뜻은 결과 꼴의 Item 과 같다.",
      "properties": {
        "runId": {
          "description": "그 재판단 실행의 id.",
          "title": "Runid",
          "type": "integer"
        },
        "judgedAt": {
          "description": "재판단이 끝난 때(+09:00 ISO 8601).",
          "title": "Judgedat",
          "type": "string"
        },
        "judgedBy": {
          "$ref": "#/$defs/GreenwashReviewer",
          "description": "재판단을 누른 사람(못 풀면 이름 「알 수 없는 사용자」)."
        },
        "outcome": {
          "description": "judged = 등급이 났다 · nonrisk = AI 가 리스크 아님으로 봤다(level null — 문장은 지우지 않는다).",
          "enum": [
            "judged",
            "nonrisk"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "High",
                "Mid",
                "Low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level"
        },
        "riskTags": {
          "items": {
            "type": "string"
          },
          "title": "Risktags",
          "type": "array"
        },
        "confirmedInEvidence": {
          "items": {
            "type": "string"
          },
          "title": "Confirmedinevidence",
          "type": "array"
        },
        "missingFields": {
          "items": {
            "type": "string"
          },
          "title": "Missingfields",
          "type": "array"
        },
        "reasonBullets": {
          "items": {
            "type": "string"
          },
          "title": "Reasonbullets",
          "type": "array"
        },
        "fixParagraph": {
          "title": "Fixparagraph",
          "type": "string"
        },
        "evidencePages": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Evidencepages",
          "type": "array"
        },
        "added": {
          "description": "이 판단에 보낸 더한 조각. 근거 고침의 added 가 이것과 같고 removed 가 비면 다시 판단할 것이 없다.",
          "items": {
            "$ref": "#/$defs/GreenwashEvidenceAdded"
          },
          "title": "Added",
          "type": "array"
        }
      },
      "required": [
        "runId",
        "judgedAt",
        "judgedBy",
        "outcome",
        "level",
        "riskTags",
        "confirmedInEvidence",
        "missingFields",
        "reasonBullets",
        "fixParagraph",
        "evidencePages",
        "added"
      ],
      "title": "GreenwashRejudged",
      "type": "object"
    },
    "GreenwashReviewEdit": {
      "additionalProperties": false,
      "description": "문장 하나의 고침. 칸 셋 중 하나 이상이 값이다. AI 원본은 결과 items[itemIndex].",
      "properties": {
        "itemIndex": {
          "description": "결과 items 의 차례(0부터).",
          "minimum": 0,
          "title": "Itemindex",
          "type": "integer"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenwashReviewEditedLevel"
            },
            {
              "type": "null"
            }
          ],
          "description": "고친 등급. null 이면 AI 등급 그대로."
        },
        "reasonBullets": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenwashReviewEditedReasons"
            },
            {
              "type": "null"
            }
          ],
          "description": "고친 판정 사유. null 이면 AI 판정 사유 그대로."
        },
        "fixParagraph": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenwashReviewEditedFix"
            },
            {
              "type": "null"
            }
          ],
          "description": "고친 수정 방향. null 이면 AI 수정 방향 그대로."
        }
      },
      "required": [
        "itemIndex",
        "level",
        "reasonBullets",
        "fixParagraph"
      ],
      "title": "GreenwashReviewEdit",
      "type": "object"
    },
    "GreenwashReviewEditedFix": {
      "additionalProperties": false,
      "description": "고친 수정 방향. 칸의 값과 그 값을 넣은 때·사람.",
      "properties": {
        "value": {
          "description": "고친 수정 방향(빈 글자 아님).",
          "title": "Value",
          "type": "string"
        },
        "editedAt": {
          "description": "이 칸을 고친 때(+09:00 ISO 8601). 이 칸 값이 바뀐 PUT 의 때.",
          "title": "Editedat",
          "type": "string"
        },
        "editedBy": {
          "$ref": "#/$defs/GreenwashReviewer",
          "description": "이 칸을 고친 사람(못 풀면 이름 「알 수 없는 사용자」)."
        }
      },
      "required": [
        "value",
        "editedAt",
        "editedBy"
      ],
      "title": "GreenwashReviewEditedFix",
      "type": "object"
    },
    "GreenwashReviewEditedLevel": {
      "additionalProperties": false,
      "description": "고친 등급. 칸의 값과 그 값을 넣은 때·사람.",
      "properties": {
        "value": {
          "description": "고친 등급.",
          "enum": [
            "High",
            "Mid",
            "Low"
          ],
          "title": "Value",
          "type": "string"
        },
        "editedAt": {
          "description": "이 칸을 고친 때(+09:00 ISO 8601). 이 칸 값이 바뀐 PUT 의 때.",
          "title": "Editedat",
          "type": "string"
        },
        "editedBy": {
          "$ref": "#/$defs/GreenwashReviewer",
          "description": "이 칸을 고친 사람(못 풀면 이름 「알 수 없는 사용자」)."
        }
      },
      "required": [
        "value",
        "editedAt",
        "editedBy"
      ],
      "title": "GreenwashReviewEditedLevel",
      "type": "object"
    },
    "GreenwashReviewEditedReasons": {
      "additionalProperties": false,
      "description": "고친 판정 사유. 칸의 값과 그 값을 넣은 때·사람.",
      "properties": {
        "value": {
          "description": "고친 판정 사유(줄마다 하나, 빈 줄 없음).",
          "items": {
            "type": "string"
          },
          "title": "Value",
          "type": "array"
        },
        "editedAt": {
          "description": "이 칸을 고친 때(+09:00 ISO 8601). 이 칸 값이 바뀐 PUT 의 때.",
          "title": "Editedat",
          "type": "string"
        },
        "editedBy": {
          "$ref": "#/$defs/GreenwashReviewer",
          "description": "이 칸을 고친 사람(못 풀면 이름 「알 수 없는 사용자」)."
        }
      },
      "required": [
        "value",
        "editedAt",
        "editedBy"
      ],
      "title": "GreenwashReviewEditedReasons",
      "type": "object"
    },
    "GreenwashReviewEvidence": {
      "additionalProperties": false,
      "description": "문장 하나의 근거 고침. removed·added 가운데 하나 이상이 비지 않는다.",
      "properties": {
        "itemIndex": {
          "description": "결과 items 의 차례(0부터).",
          "minimum": 0,
          "title": "Itemindex",
          "type": "integer"
        },
        "removed": {
          "description": "기준 판단의 confirmedInEvidence 차례 가운데 지운 것(오름·겹침 없음).",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Removed",
          "type": "array"
        },
        "added": {
          "description": "더한 조각(받은 차례).",
          "items": {
            "$ref": "#/$defs/GreenwashEvidenceAdded"
          },
          "title": "Added",
          "type": "array"
        },
        "editedAt": {
          "description": "근거를 마지막으로 고친 때(+09:00 ISO 8601).",
          "title": "Editedat",
          "type": "string"
        },
        "editedBy": {
          "$ref": "#/$defs/GreenwashReviewer",
          "description": "근거를 마지막으로 고친 사람(못 풀면 이름 「알 수 없는 사용자」)."
        }
      },
      "required": [
        "itemIndex",
        "removed",
        "added",
        "editedAt",
        "editedBy"
      ],
      "title": "GreenwashReviewEvidence",
      "type": "object"
    },
    "GreenwashReviewMark": {
      "additionalProperties": false,
      "description": "문장 하나의 표시.",
      "properties": {
        "itemIndex": {
          "description": "결과 items 의 차례(0부터).",
          "minimum": 0,
          "title": "Itemindex",
          "type": "integer"
        },
        "decision": {
          "description": "채택 · 제외.",
          "enum": [
            "adopted",
            "excluded"
          ],
          "title": "Decision",
          "type": "string"
        },
        "excludeReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "제외 사유. excluded 일 때만 글, 그 밖에는 null.",
          "title": "Excludereason"
        }
      },
      "required": [
        "itemIndex",
        "decision",
        "excludeReason"
      ],
      "title": "GreenwashReviewMark",
      "type": "object"
    },
    "GreenwashReviewRejudge": {
      "additionalProperties": false,
      "description": "문장 하나의 재판단 상태.",
      "properties": {
        "itemIndex": {
          "description": "결과 items 의 차례(0부터).",
          "minimum": 0,
          "title": "Itemindex",
          "type": "integer"
        },
        "status": {
          "description": "가장 늦게 만든 재판단 실행의 상태.",
          "enum": [
            "running",
            "failed",
            "done"
          ],
          "title": "Status",
          "type": "string"
        },
        "count": {
          "description": "끝난(done) 재판단 수.",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenwashRejudged"
            },
            {
              "type": "null"
            }
          ],
          "description": "기준 판단. 끝난 재판단이 없으면 null(첫 판단은 결과 GET 의 items[itemIndex])."
        }
      },
      "required": [
        "itemIndex",
        "status",
        "count",
        "current"
      ],
      "title": "GreenwashReviewRejudge",
      "type": "object"
    },
    "GreenwashReviewer": {
      "additionalProperties": false,
      "description": "확정한 사람. 응답 전용(본문에 오지 않는다 — 사람은 세션에서 온다).",
      "properties": {
        "id": {
          "description": "사용자 id(int). 세션의 user_id(글자)를 int 로 바꾸는 것은 G1b 몫이다.",
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "description": "화면에 보일 이름(빈 글자 아님).",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "GreenwashReviewer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "greenwash.review@3 — 한 실행의 검토 상태. schemaVersion 이 첫 키다.",
  "properties": {
    "schemaVersion": {
      "const": "greenwash.review@3",
      "title": "Schemaversion",
      "type": "string"
    },
    "runId": {
      "description": "검토하는 실행의 id.",
      "title": "Runid",
      "type": "integer"
    },
    "state": {
      "description": "검토 상태.",
      "enum": [
        "pending",
        "in_review",
        "confirmed"
      ],
      "title": "State",
      "type": "string"
    },
    "confirmedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "확정한 때(+09:00 ISO 8601). confirmed 일 때만 값, 그 밖에는 null.",
      "title": "Confirmedat"
    },
    "confirmedBy": {
      "anyOf": [
        {
          "$ref": "#/$defs/GreenwashReviewer"
        },
        {
          "type": "null"
        }
      ],
      "description": "확정한 사람. confirmed 일 때만 값, 그 밖에는 null(confirmedAt 과 같은 규칙)."
    },
    "marks": {
      "description": "표시한 문장(itemIndex 오름차순, 겹치지 않음). 없는 문장은 미검토. confirmed 이면 결과의 items 전부다.",
      "items": {
        "$ref": "#/$defs/GreenwashReviewMark"
      },
      "title": "Marks",
      "type": "array"
    },
    "edits": {
      "description": "고친 문장(itemIndex 오름차순, 겹치지 않음). 고친 칸이 하나 이상인 문장만, 없으면 [].",
      "items": {
        "$ref": "#/$defs/GreenwashReviewEdit"
      },
      "title": "Edits",
      "type": "array"
    },
    "evidence": {
      "description": "근거를 고친 문장(itemIndex 오름차순, 겹치지 않음). 없으면 [].",
      "items": {
        "$ref": "#/$defs/GreenwashReviewEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "rejudges": {
      "description": "재판단 실행이 있는 문장(itemIndex 오름차순, 겹치지 않음). 없으면 [].",
      "items": {
        "$ref": "#/$defs/GreenwashReviewRejudge"
      },
      "title": "Rejudges",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "state",
    "confirmedAt",
    "confirmedBy",
    "marks",
    "edits",
    "evidence",
    "rejudges"
  ],
  "title": "GreenwashReviewState",
  "type": "object"
}

    esgapi.inventory.engines.scope3

; 자 다섯째. Scope 3 엔진의 판(engines/scope3/<판>/)끼리도 서로 모른다(MARC-ENT-267 판별 복사 — 같은 꼴도 복사한다).
;    판을 더하면 여기 modules 에 한 줄(inventory/README.md 「다음 판 넣는 법」). 간접 사슬도 문다.
[importlinter:contract:inventory-scope3-versions-apart]
name = 자. 인벤토리 축: Scope 3 엔진의 판끼리(llm_first_1·colab_157)는 서로를 import 하지 않는다 (간접도)
type = independence
modules =
    esgapi.inventory.engines.scope3.llm_first_1
    esgapi.inventory.engines.scope3.colab_157

; 차. 실행 층(runs, MARC-ENT-210 (1))은 흐름을 모르는 공통 자리다. core 처럼 업무 모듈을 import 하지 않는다.
;    회사 FK 는 core 처럼 글자 참조("organization.Company")로 둔다. runs 는 core 를 딛는다(가 의 금지 목록에 runs 가 있다).
;    간접도 문다(가 와 같다).
[importlinter:contract:runs-knows-no-module]
name = 차. runs 는 업무 모듈을 import 하지 않는다
type = forbidden
source_modules =
    esgapi.runs
forbidden_modules =
    esgapi.organization
    esgapi.user
    esgapi.inventory
    esgapi.reference
    esgapi.reconcile
    esgapi.greenwash
    esgapi.dataverify
    esgapi.translation
    esgapi.materiality
    esgapi.drafting
    esgapi.runbundle

; 차-2. 업무 모듈끼리는 어느 층(tools·flows·actions·engines·outputs·contracts·service 전부)에서도 서로를 import 하지
;    않는다(MARC-ISSUE-479, 밴드 QC3). 나·바 는 models·service/selector 만 문다 — 그 밖 층의 남의 모듈 import 를 여기서 막는다.
;    independence 라 간접 사슬도 문다. 바닥 모듈(core·runs·organization·user·reference·config)은 목록 밖이다.
;    ★ 모듈을 더하면 여기 modules 에 한 줄.
[importlinter:contract:business-modules-apart]
name = 차-2. 업무 모듈끼리는 어느 층에서도 서로를 import 하지 않는다 (간접 포함)
type = independence
modules =
    esgapi.greenwash
    esgapi.translation
    esgapi.dataverify
    esgapi.materiality
    esgapi.drafting
    esgapi.inventory
    esgapi.reconcile
    esgapi.runbundle
;    이 계약은 제품 코드만 본다: 모듈의 시험은 남의 계약 꼴(contracts.shapes)과 config.api(라우터 전부)를 일부러 엮는다.
;    시험의 규칙은 사 계약과 별개다. 와일드카드가 헛돌면 조용하다 — 줄을 고치면 scripts/planted-breaks-QC3.sh 로 잰다.
ignore_imports =
    esgapi.*.tests.** -> esgapi.**
unmatched_ignore_imports_alerting = none

; 카. 실행 묶음(runbundle, RX1a — MARC-ENT-440)은 업무 모듈과 남의 models 를 import 하지 않는다. runs·core·organization·
;    user 는 selectors·services 로만, 모듈은 등록부 CARRIERS(core/flows/carriers.py)로만 닿는다. 간접 길은 연다(True):
;    services 를 거친 models 간접 길은 정당하다(모듈에는 등록부로만 닿는다).
[importlinter:contract:runbundle-knows-no-module]
name = 카. runbundle 은 업무 모듈과 남의 models 를 import 하지 않는다 (selectors·services·등록부로만)
type = forbidden
source_modules =
    esgapi.runbundle
forbidden_modules =
    esgapi.greenwash
    esgapi.translation
    esgapi.dataverify
    esgapi.materiality
    esgapi.drafting
    esgapi.inventory
    esgapi.reconcile
    esgapi.reference
    esgapi.runs.models
    esgapi.core.models
    esgapi.user.models
    esgapi.organization.models
allow_indirect_imports = True

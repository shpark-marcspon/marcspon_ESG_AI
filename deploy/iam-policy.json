{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Read",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetConsoleOutput", "dlm:GetLifecyclePolicies", "dlm:GetLifecyclePolicy"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "RunTagged",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2", "aws:RequestTag/Project": "marcspon-demo" }
      }
    },
    {
      "Sid": "RunOther",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2::image/*",
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:key-pair/*",
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:network-interface/*"
      ],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "Create",
      "Effect": "Allow",
      "Action": ["ec2:ImportKeyPair", "ec2:AllocateAddress"],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2", "aws:RequestTag/Project": "marcspon-demo" }
      }
    },
    {
      "Sid": "CreateSg",
      "Effect": "Allow",
      "Action": ["ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2", "aws:RequestTag/Project": "marcspon-demo" }
      }
    },
    {
      "Sid": "CreateSgVpc",
      "Effect": "Allow",
      "Action": ["ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:vpc/*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "TagOnCreate",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "ec2:CreateAction": ["RunInstances", "ImportKeyPair", "CreateSecurityGroup", "AllocateAddress", "CreateSnapshot"]
        }
      }
    },
    {
      "Sid": "SgRules",
      "Effect": "Allow",
      "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"],
      "Resource": "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2", "ec2:ResourceTag/Project": "marcspon-demo" }
      }
    },
    {
      "Sid": "Eip",
      "Effect": "Allow",
      "Action": ["ec2:AssociateAddress"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "Power",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances", "ec2:StartInstances", "ec2:RebootInstances"],
      "Resource": "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-northeast-2", "ec2:ResourceTag/Project": "marcspon-demo" }
      }
    },
    {
      "Sid": "Dlm",
      "Effect": "Allow",
      "Action": ["dlm:CreateLifecyclePolicy", "dlm:TagResource"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "PassDlm",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/*AWSDataLifecycleManagerDefaultRole",
      "Condition": { "StringEquals": { "iam:PassedToService": "dlm.amazonaws.com" } }
    },
    {
      "Sid": "R53",
      "Effect": "Allow",
      "Action": ["route53:ListHostedZonesByName", "route53:GetHostedZone", "route53:ListResourceRecordSets", "route53:GetChange"],
      "Resource": "*"
    },
    {
      "Sid": "R53Rec",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/HOSTED_ZONE_ID"
    },
    {
      "Sid": "Snap",
      "Effect": "Allow",
      "Action": ["ec2:CreateSnapshot"],
      "Resource": ["arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:volume/*", "arn:aws:ec2:ap-northeast-2::snapshot/*"],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "R53Health",
      "Effect": "Allow",
      "Action": ["route53:CreateHealthCheck", "route53:GetHealthCheck", "route53:GetHealthCheckStatus", "route53:ListHealthChecks", "route53:ChangeTagsForResource"],
      "Resource": "*"
    },
    {
      "Sid": "Alerts",
      "Effect": "Allow",
      "Action": ["sns:CreateTopic", "sns:TagResource", "sns:Subscribe", "sns:ListTopics", "sns:ListSubscriptionsByTopic", "cloudwatch:PutMetricAlarm", "cloudwatch:TagResource", "cloudwatch:DescribeAlarms"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    }
  ]
}

# 시연 서버의 .env 틀(밴드 DP1). 이름·설명·고정 값만 있고 비밀 값은 0 이다.
# 서버의 진짜 파일은 /srv/esg-demo/shared/.env 하나(소유 deploy, 600)이고 deploy/make-env.sh 가 이 틀로 만든다.
#   둘째 벌(데모 고정판, 밴드 DM1)은 /srv/esg-demo2/shared/.env — make-env.sh 가 같은 틀에 「둘째 벌 고정 칸」을 채운다(맨 아래).
#   비밀(★ 표시)은 make-env.sh 가 openssl rand -hex 32 로 채운다 — 16진뿐이라 postgres://u:PASS@ 주소를 깨지 않는다.
#   LLM 키는 deploy/put-llm-key.sh 가 넣는다(운영 기계의 키 파일 → ssh 표준 입력). 손으로 적지 않는다.
# 이 파일에 진짜 값을 적지 않는다(저장소에 들어간다). 서버의 .env 를 docker compose config·env·printenv 로 찍지 않는다.

# ── 프로젝트 이름: 고정. 바꾸면 compose 가 새 빈 볼륨(postgres-data 등)을 만든다 — 시연 DB 가 안 보인다 ──
COMPOSE_PROJECT_NAME=esg-demo

# ── 주소(make-env.sh 의 인자). 둘 다 DNS A 레코드가 서버의 탄력적 IP 여야 Caddy 가 인증서를 받는다 ──
# 웹 주소의 호스트 이름(예: esg.<도메인>). 브라우저가 여는 https://<SITE_DOMAIN>/
SITE_DOMAIN=
# 저장소 주소의 호스트 이름(예: files.esg.<도메인>). 서명한 올리기 주소가 여기를 가리킨다.
FILES_DOMAIN=
# 저장소가 브라우저의 PUT 을 받는 출처 하나 = https://<SITE_DOMAIN> (make-env.sh 가 채운다. * 는 storage-cors 가 거절)
STORAGE_CORS_ORIGINS=

# ── PostgreSQL ──
POSTGRES_DB=esg
POSTGRES_OWNER_USER=esg_owner
# ★ 주인 역할의 비밀번호(make-env.sh)
POSTGRES_OWNER_PASSWORD=
# ★ 앱 역할(esg_app)의 비밀번호(make-env.sh)
APP_DB_PASSWORD=

# ── 원본 파일 저장소(서버 안 Versity, 볼륨 storage-data) ──
S3_BUCKET=esg-documents
S3_REGION=ap-northeast-2
# ★ 저장소 접근 키 둘(make-env.sh)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 빈 값 = compose 기본(300초, 50 MiB)
UPLOAD_URL_TTL_SECONDS=
MAX_UPLOAD_BYTES=

# ── 로그인 ──
# ★ 로그인 토큰을 서명하는 비밀(32바이트 이상, make-env.sh)
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
# EDK 토큰 검증 공개키: make-env.sh 가 새 RSA 키 쌍을 만들어 공개키만 적고 개인키는 버린다(PEM 줄바꿈은 글자 \n, 따옴표 없음).
#   compose.yaml 의 기본값은 저장소에 적힌 개발용이라 쓰지 않는다 — 이것으로 EDK 교환 길이 닫힌다(시연은 아이디 로그인).
EDK_JWT_PUBLIC_KEY=
EDK_JWT_AUDIENCE=esg-api
EDK_JWT_ISSUER=https://edk.local.invalid

# ── LLM ──
# 실행기의 모드: 첫 기동은 빈 값(mock)으로 띄워 주소·인증서를 먼저 살린다. put-llm-key.sh 가 키를 넣으며 live 로 바꾼다.
#   ★ mock 으로 띄우면 영문번역은 늘 setup_error 다(MARC-ISSUE-331 1) — 배포본은 live 로만 쓴다.
LLM_RUN_MODE=
# live 면 db 가 필수(호출 기록 표 core_llm_call_logs — 비용 장부)
LLM_LOG_SINK=db
# 실행 하나의 상한(USD). 사용자 결정 MARC-ENT-416(「없애줘」 — live 는 값이 필수라 한 번 상한 끝값 5.00)
LLM_RUN_MAX_USD=5.00
# 영문번역 실행 하나의 상한(USD, MARC-ENT-513). compose.yaml 에 칸이 없어 deploy/compose.prod.yaml 이 넘긴다(비면 기동 멈춤).
TRANSLATION_RUN_MAX_USD=10.00
# Scope 3 실행 스위치(MARC-ENT-535). 비거나 없으면 꺼짐. true·false 만 — 다른 값은 기동이 멈춘다.
#   ★ mock 으로 띄우면 Scope 3 실행은 늘 setup_error 로 끝난다 — 배포본은 live 로만 쓴다.
INVENTORY_SCOPE3_RUNS_ENABLED=true
# ★ 공급사 키: put-llm-key.sh 가 넣는다(마크스폰 키). 컨테이너에는 이 이름으로만 간다(OPENAI_* 이름 0).
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GEMINI_API_KEY=
# 빈 값 = 이미지에 실린 models.json(모델 ID·단가)
LLM_MODELS_FILE=
LLM_JSONL_PATH=
LLM_RPM=

# ── 그 밖(빈 값 = 기본) ──
PARSER_URL=
PARSER_TIMEOUT_MS=210000
CELERY_VISIBILITY_TIMEOUT_SECONDS=
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=
CELERY_TASK_TIME_LIMIT_SECONDS=
JOB_LEASE_SECONDS=
JOB_MAX_ATTEMPTS=
JOB_RETRY_DELAY_SECONDS=
CELERY_WAIT_TIME_SECONDS=
# 서버는 빈 값(80·443, 서명 주소에 포트 없음). 로컬 리허설만 채운다.
PROXY_HTTP_PORT=
PROXY_HTTPS_PORT=
PROXY_PUBLIC_PORT_SUFFIX=

# ── 두 벌(밴드 DM1 — docs/deploy-demo.md 11절) ──
# 이 벌이 proxy(80·443)를 띄우는가: 빈 값·edge = 띄움(첫 벌), none = 안 띄움(둘째 벌 — 첫 벌 Caddy 가 이름을 받아 넘긴다).
#   둘째 벌 .env 는 make-env.sh 가 none 으로 채운다. 뿌리와 어긋나면 up.sh 가 멈춘다(/srv/esg-demo = edge, /srv/esg-demo2 = none).
PROXY_ROLE=
# 첫 벌 .env 에만: 둘째 벌의 바깥 이름 둘(둘 다 있거나 둘 다 빈 값). 비면 첫 벌 Caddy 설정이 지금과 같다.
#   채우면 첫 벌 up.sh 가 deploy/compose.edge-proxy.yaml 을 얹고 Caddy 가 두 이름의 인증서를 받는다(DNS A 레코드 먼저).
DEMO2_SITE_DOMAIN=
DEMO2_FILES_DOMAIN=
# 첫 벌 proxy 와 둘째 벌 relay 가 같이 붙는 도커 네트워크 이름. 빈 값 = esg-edge(두 벌 .env 가 같아야 한다).
EDGE_NETWORK=
# 호스트 127.0.0.1 에만 여는 들여다보기 포트(compose.yaml). 빈 값 = compose 기본(15432·19000·18081 — 첫 벌).
#   둘째 벌은 make-env.sh 가 25432·29000·28081 로 채운다(같은 기계에서 겹치면 둘째 벌이 못 뜬다).
POSTGRES_PORT=
STORAGE_PORT=
API_PY_PORT=

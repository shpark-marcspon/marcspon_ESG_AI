# 내 값을 적는 파일의 예시.   cp terraform.tfvars.example terraform.tfvars   로 복사해 고친다.
# terraform.tfvars 는 git 에 넣지 않는다(.gitignore). 여기에 비밀번호나 키를 적을 일은 없다.

region             = "ap-northeast-2"
availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]

# ── 켜고 끄는 것 ──
# 처음 적용할 때의 권장 차례는 infra/README.md 에 있다: compute 를 끈 채로 시작한다.
enable_nat_gateway = false
enable_queue_redis = true
enable_database    = true
enable_compute     = false

# ── compute 를 켤 때 ──
# ECR 에 올린 이미지의 태그(server 와 parser 에 같은 태그)
image_tag = "initial"
# 이미지를 만든 CPU. 애플 실리콘 맥에서 그냥 빌드했으면 ARM64
cpu_architecture = "ARM64"

# compute 는 TS 서버 기준이라 api-py 로 다시 쓸 때까지 켜지 않는다(sid:MARC-ISSUE-108).
# 켤 때는 둘 다 필수다: ALB 에 들어올 좁은 주소 범위(/0 이면 실패)와 HTTPS 인증서(ACM)의 ARN.
# alb_ingress_cidr    = "203.0.113.7/32"
# alb_certificate_arn = "arn:aws:acm:ap-northeast-2:<계정 번호>:certificate/<id>"

# 브라우저에서 직접 올릴 화면의 주소
# cors_allowed_origins = ["http://localhost:5173"]

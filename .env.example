# 로컬에서 띄울 때의 값.  cp .env.example .env  로 복사해 쓴다 (.env 는 git 에 넣지 않는다).
# compose.yaml 이 이 파일을 읽어 ${...} 자리에 넣는다.
#
# ★ 아래 비밀번호와 키는 이 컴퓨터 안의 컨테이너끼리만 쓰는 가짜 값이다. 진짜 비밀은 저장소에 적지 않는다.
#   프로덕션에서는 비밀 관리 도구(AWS Secrets Manager 등)가 컨테이너의 환경 변수로 넣어 준다.

# ── compose 프로젝트 이름. 컨테이너·볼륨·이미지 이름 앞에 붙는다 ──
# 워크트리로 여러 벌 띄울 때는 scripts/worktree-env.sh 가 이 값과 아래 포트를 겹치지 않게 채운다.
COMPOSE_PROJECT_NAME=esg-app

# ── 호스트(내 컴퓨터)에 여는 포트. 다른 프로젝트와 겹치면 여기만 바꾼다 ──
API_PORT=18080
API_PY_PORT=18081
POSTGRES_PORT=15432
STORAGE_PORT=19000
# 웹 개발 서버(vite)의 포트. 저장소의 CORS 허락 출처(compose 의 storage-cors)가 이 값을 쓴다.
# ★ vite 는 이 파일을 읽지 않는다: 같은 값을  WEB_PORT=$(sed -n 's/^WEB_PORT=//p' .env | grep . || echo 15173) pnpm --filter @esg/web dev  로 준다
#   (.env 에 WEB_PORT 가 없으면(이 밴드 전에 만든 main·워크트리) 15173. 빈 값이면 vite 가 포트 0 에 뜬다).
WEB_PORT=15173

# ── PostgreSQL ──
POSTGRES_DB=esg
# 주인 역할: 테이블을 만들고 바꾼다. 마이그레이션만 이 역할을 쓴다.
POSTGRES_OWNER_USER=esg_owner
POSTGRES_OWNER_PASSWORD=local-only-owner-password
# 앱 역할(이름은 esg_app 으로 고정): api 와 worker 가 쓴다. RLS 를 우회하지 못한다.
APP_DB_PASSWORD=local-only-app-password

# ── 원본 파일 저장소 (로컬: S3 호환 저장소, 프로덕션: S3) ──
S3_BUCKET=esg-documents
S3_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=local-only-access-key
STORAGE_SECRET_KEY=local-only-secret-key
# ★ 개발 단계에 실제 고객 문서를 올리지 않는다. 올린 원본은 저장소에 그대로 남는다(올리기가 곧 저장이다).
#   로컬의 버킷은 compose 의 볼륨이라 `docker compose down -v` 로 지워진다. 지우기·보존 기간은 아직 정하지 않았다.
# 아래 둘은 선택이다(apps/api-py 가 읽는다). 비워 두면 compose 가 기본값을 넣는다.
# 서명한 올리기 주소의 수명(초). 기본 300.
UPLOAD_URL_TTL_SECONDS=
# 올릴 수 있는 파일 하나의 상한(바이트). 기본 52428800(50 MiB. 파서가 받는 원본의 상한 기본값과 같다).
MAX_UPLOAD_BYTES=
# 브라우저가 서명한 주소로 저장소에 PUT 해도 되는 출처(쉼표 목록, 선택). 비우면 compose 가 넷을 넣는다:
# localhost·127.0.0.1 × (WEB_PORT, API_PY_PORT). 출처는 스킴://호스트:포트 꼴 — 끝 `/`·경로·`*` 는 받지 않는다.
STORAGE_CORS_ORIGINS=

# ── Python 쪽의 작업 큐 (apps/api-py 의 worker-py, Celery) ──
# 로컬의 브로커는 compose 의 queue(SQS 흉내)이고 그 주소는 compose.yaml 에 글자로 적혀 있다(여기서 바꾸지 않는다:
# 브로커 주소에 호스트가 빠지면 진짜 AWS 를 부른다. 설명은 README 의 「워커와 큐 (Celery)」).
# 아래 일곱은 선택이다. 비워 두면 기본값이다. 긴 폴링 말고는 전부 어림이다(재서 정한 것이 아니다).
# 큐의 visibility(초). 기본 120. 로컬의 큐는 docker/elasticmq.conf 가 정한다: 그 값과 같게 둔다.
CELERY_VISIBILITY_TIMEOUT_SECONDS=
# 태스크 하나의 시간 제한(초). 소프트(기본 60) < 하드(기본 75).
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=
CELERY_TASK_TIME_LIMIT_SECONDS=
# 워커가 일감을 쥐고 있다고 표에 적는 시간(초). 기본 90. 하드 제한보다 길고 visibility 보다 짧아야 한다.
JOB_LEASE_SECONDS=
# 한 일감을 몇 번까지 잡는가(첫 시도 포함. 기본 3)와, 잠깐의 실패 뒤 다시 해 보기까지(초. 기본 5).
JOB_MAX_ATTEMPTS=
JOB_RETRY_DELAY_SECONDS=
# 워커의 긴 폴링(초. SQS 의 WaitTimeSeconds, 1~20). 기본 10(Celery 문서의 기본값). 짧게 하는 것은 테스트 몫이다.
CELERY_WAIT_TIME_SECONDS=

# ── 큐와 worker ──
# 한 작업을 몇 번까지 시도하는가(첫 시도 포함), 다시 시도 사이의 기본 대기(ms, 지수로 늘어난다)
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
# worker 가 죽었을 때 작업이 큐로 돌아오기까지의 시간(ms). 로컬에서는 실험이 빨리 끝나게 짧게 둔다.
WORKER_LOCK_MS=5000
# worker 가 파서의 답을 기다리는 최대 시간(ms)
PARSER_TIMEOUT_MS=210000

# ── Python API 뼈대 (apps/api-py) ──
# EDK 가 서명한 토큰을 검증하는 상수 셋. 검증 방법은 토큰이 아니라 이 값들에서만 온다.
# 공개키: PEM 을 한 줄로 적는다(줄바꿈은 글자 둘 \n). 아래 값은 짝이 되는 개인키를 버린 가짜 키라 아무도 서명하지 못한다.
# 로컬에서 교환을 해 보려면:  (cd apps/api-py && uv run python scripts/dev_edk.py public-key)  의 출력으로 바꾼다.
EDK_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAqyY5FBj1BS9O0U2oFV2A\nYYQoS9P3xXJinZxADavrYKvh1hD93PkQz1AUC0yCJuT8P3CAM7DDvoxQ27bQy3u5\ng7obF/M1xH/BcNCrVSPNIkUHP6vJ5dNCzh2hETFLEzUltpkCnhOqMItY86N/1GI8\nZxKqw7sk1DVAQTmqCex/UU7/qnuy8Qt+3JNCpzknjH/OOllzJkF+WV1iS9Yo/1BO\njehyjARPRYCTOfT02HJPdJ3JCBvSHiE5wppvRZGBVhPeHBM6Q8G6zIE7ophy/TGB\nz9JxhDP+clTwLRta8wnI2pFUdF4aEWXOVjBm4eeU8Zgb0s7XKy3rtpH8gZJOltK3\nIwIDAQAB\n-----END PUBLIC KEY-----\n
# 이 토큰을 받을 쪽(우리)의 이름. 토큰의 aud 가 이것과 같아야 한다.
EDK_JWT_AUDIENCE=esg-api
# 믿는 발급자. 토큰의 iss 가 이것과 같아야 한다.
EDK_JWT_ISSUER=https://edk.local.invalid
# 로그인 토큰과 옛 쿠키 세션을 서명하는 비밀(32바이트 이상. compose 에 기본값이 없어 여기서만 온다. 아래 값은 로컬 전용이라 서버가 뜰 때 경고한다 — 로컬 밖에서는 무작위 값)과 옛 쿠키 세션의 수명(초)
SESSION_SECRET=local-only-session-secret-0123456789abcdef
SESSION_TTL_SECONDS=3600

# ── LLM 호출 층 (apps/api-py 의 esgapi/core/llm) ── 전부 선택이다. 비워 두면 모의 공급사와 dry-run 만 돈다.
# 공급사의 키. ★ 진짜 키를 이 파일(.env.example)에 적지 않는다. .env 에만 적고, .env 는 git 에 넣지 않는다.
# 키가 없는 공급사의 모델을 부르면 이름 있는 오류(LiveSetupError)로 끝나고 공급사는 불리지 않는다.
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GEMINI_API_KEY=
# 모델 ID·단가·경로의 설정 파일. 비우면 이미지에 실린 자료(esgapi/core/llm/data/models.json)를 쓴다.
LLM_MODELS_FILE=
# 호출 기록이 가는 곳: memory(기본. 프로세스가 끝나면 사라진다), jsonl(아래 경로의 파일에 한 줄씩),
# db(표 core_llm_call_logs 에 한 줄씩. 요청의 트랜잭션에 실린 테넌트의 행으로 쓰인다. 본문은 저장하지 않는다).
LLM_LOG_SINK=
# LLM_LOG_SINK=jsonl 일 때의 파일 경로(그때는 필수). 컨테이너 안에서는 /tmp 아래여야 한다(/app 은 쓰지 못한다).
LLM_JSONL_PATH=
# 실제 공급사 호출의 분당 요청 수 상한(분당 한도가 있는 키용). 비우면 간격을 두지 않는다.
LLM_RPM=
# 실행기(워커)가 실제 공급사의 키를 싣는가: mock(기본·빈 값 — 모의 공급사만, 키가 있어도 싣지 않는다) | live(실호출).
# 그 밖의 값은 기동 실패다. live 면 LLM_LOG_SINK=db·키 하나 이상·LLM_RUN_MAX_USD 가 있어야 뜬다(api-py·worker 같은 값).
LLM_RUN_MODE=
# live 실행 하나의 호출 비용 상한(USD — 그 실행의 앞 시도 합 포함). 넘으면 공급사 전에 막힌다. live 면 필수.
LLM_RUN_MAX_USD=

# ── 문서 파서의 주소 (apps/api-py 가 읽는다) ── 선택이다. 비워 두면 compose 가 http://parser:8000 을 넣는다.
# 이 값은 api-py 에만 먹는다: compose 의 TS 쪽(api·worker)의 PARSER_URL 은 고정 글자(x-server-env)라 여기서 바꿔도 그대로다.
# 기다리는 최대 시간은 위의 PARSER_TIMEOUT_MS 다. 읽는 것은 api-py(worker-py 의 태스크) 하나다(TS worker 는 걷혔다).
# http:// 나 https:// 주소가 아니면 api-py 가 뜨지 않는다(설정 오류).
PARSER_URL=

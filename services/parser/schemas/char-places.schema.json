{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esg-lab.local/schemas/char-places.schema.json",
  "title": "글자 자리",
  "description": "문서 모델(document.schema.json)의 글(블록의 text, 표 칸의 글)의 글자마다 PDF 좌표. py/docparse 가 `parse --places` 로 문서 모델 곁에 낸다. 좌표는 PDF pt(왼쪽 위 원점), 쪽 번호는 1부터. 글자 자리의 단위는 UTF-16 자리(JavaScript 문자열의 자리)다. 여기에는 「어디가 숫자인가」가 없다: 읽는 쪽이 글자 범위를 주면 그 범위의 상자를 줄마다 묶어 얻는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "parser", "unit", "containers", "unlinked"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "page_count"],
      "description": "같은 PDF 의 문서 모델과 같은 값이다",
      "properties": {
        "file_name": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "table_strategy"],
      "properties": {
        "name": {"const": "docparse"},
        "version": {"type": "string"},
        "table_strategy": {"enum": ["auto", "lines", "text"]},
        "layout": {"const": 2, "description": "분해 판. 문서 모델의 parser.layout 과 같다(layout 2 일 때만 있다)"}
      }
    },
    "unit": {"const": "utf16", "description": "start 와 글자별 배열의 단위. 보충 평면 글자(이모지 등)는 두 자리를 차지하고 두 자리에 같은 상자가 실린다"},
    "containers": {
      "type": "array",
      "description": "글이 있는 그릇마다 하나. 문서 모델의 블록·표와 같은 차례다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "page", "bbox", "runs"],
        "properties": {
          "id": {"type": "string", "description": "block 이면 문서 모델의 블록 ID(`p3-b2`), cell 이면 `표ID:r행c열`(`p3-t1:r2c4`, 행·열은 0부터)"},
          "kind": {"enum": ["block", "cell"]},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"$ref": "#/$defs/bbox", "description": "그릇의 글자 전체를 감싼 상자 (칸의 경계가 아니라 글자의 범위)"},
          "runs": {
            "type": "array",
            "minItems": 1,
            "description": "줄 토막. 글의 차례대로다. 그릇의 글에서 어느 토막에도 들지 않는 자리는 분해가 끼운 빈칸이다(좌표 없음). 한 줄이 여러 토막일 수 있다(글자 크기가 다른 조각은 y0·y1 이 다르다). 글자 범위의 상자를 낼 때는 차례로 이웃한 두 토막의 세로 범위가 겹친 높이가 낮은 쪽 높이의 절반을 넘으면 한 줄로 보고 합집합 상자 하나로 묶는다. 아니면 줄이 바뀐 것이고 상자가 따로다",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "y0", "y1", "x0", "x1"],
              "properties": {
                "start": {"type": "integer", "minimum": 0, "description": "토막의 첫 글자가 그릇의 글에서 몇 번째 자리인가 (UTF-16)"},
                "y0": {"type": "number"},
                "y1": {"type": "number"},
                "x0": {"type": "array", "minItems": 1, "items": {"type": "number"}, "description": "글자마다 왼쪽 끝. k 번째 값은 글의 start+k 자리의 것"},
                "x1": {"type": "array", "minItems": 1, "items": {"type": "number"}, "description": "글자마다 오른쪽 끝. x0 과 길이가 같다"}
              }
            }
          }
        }
      }
    },
    "unlinked": {
      "type": "array",
      "description": "글은 있는데 글자 자리를 잇지 못한 그릇. 지어내지 않고 까닭과 함께 남긴다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "page", "reason"],
        "properties": {
          "id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "reason": {"enum": ["text_differs_from_chunks", "glyphs_not_aligned", "empty"]}
        }
      }
    }
  },
  "$defs": {
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[x0, y0, x1, y1] pt"}
  }
}
